# Copy this file to .env and replace the example values.
IMAGE_TAG=edge

# Telegram bot token from @BotFather
API_KEY=replace-with-your-telegram-bot-token

# Target Telegram group ID (negative, usually starts with -100)
TELEGRAM_GROUP_ID=-1001234567890

# Forum topic ID; use 0 for the General topic
TELEGRAM_TOPIC_ID=0

# Gitea Mirror API URL and API key
GITEA_BASE_URL=https://gitea-mirror.example.com
GITEA_API_KEY=replace-with-your-gitea-mirror-api-key